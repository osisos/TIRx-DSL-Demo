# from tvm.script import ir as I
# from tvm.script import tirx as T

@I.ir_module
class Module:
    @T.prim_func
    def main(A_handle: T.handle, B_handle: T.handle, H_handle: T.handle, Out_handle: T.handle):
        A = T.match_buffer(A_handle, (64, 64), "float16", strides=(64, 1))
        B = T.match_buffer(B_handle, (64, 64), "float16", strides=(64, 1))
        H = T.match_buffer(H_handle, (64, 64), "float16", strides=(64, 1))
        Out = T.match_buffer(Out_handle, (64, 64), strides=(64, 1))
        # with T.sblock("root"):
        for bx in T.thread_binding(1, thread="blockIdx.x"):
            tx: T.int32 = T.launch_thread_idx(0)
            ty: T.int32 = T.launch_thread_idx(1)
            tz: T.int32 = T.launch_thread_idx(2)
            with T.sblock("tilelang_root"):
                T.reads()
                T.writes()
                T.sblock_attr({"tl.launch_threads": [128, 1, 1]})
                As = T.sblock_alloc_buffer((64, 64), "float16", scope="shared.dyn")
                Bs = T.sblock_alloc_buffer((64, 64), "float16", scope="shared.dyn")
                acc = T.sblock_alloc_buffer((64, 64), scope="local.fragment")
                wide = T.sblock_alloc_buffer((64, 64), scope="local.fragment")
                stat = T.sblock_alloc_buffer((64,), scope="local.fragment")
                out = T.sblock_alloc_buffer((64, 64), scope="local.fragment")
                T.copy(T.region(A[0, 0], 1, 64, 64), T.region(As[0, 0], 2, 64, 64))
                T.copy(T.region(B[0, 0], 1, 64, 64), T.region(Bs[0, 0], 2, 64, 64))
                T.fill(T.region(acc[0, 0], 2, 64, 64), 0)
                T.gemm(T.region(As[0, 0], 1, 64, 64), T.region(Bs[0, 0], 1, 64, 64), T.region(acc[0, 0], 3, 64, 64), T.bool(False), T.bool(False), 64, 64, 64, 0, T.bool(False), 0, 0, 0)
                for i in T.parallel(64):
                    for j in T.parallel(64):
                        wide[i, j] = T.Cast("float32", H[i, j])
                T.reduce(T.region(wide[0, 0], 1, 64, 64), T.region(stat[0], 2, 64), "sum", 1, T.bool(True))
                for i in T.parallel(64):
                    for j in T.parallel(64):
                        out[i, j] = stat[i] + acc[i, j]
                T.copy(T.region(out[0, 0], 1, 64, 64), T.region(Out[0, 0], 2, 64, 64))