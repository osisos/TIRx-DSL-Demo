# from tvm.script import ir as I
# from tvm.script import tirx as T

@I.ir_module
class Module:
    @T.prim_func
    def main(A_handle: T.handle, B_handle: T.handle, C_handle: T.handle):
        T.func_attr({"target": T.target({"arch": "sm_89", "host": {"keys": ["cpu"], "kind": "c", "tag": ""}, "keys": ["cuda", "gpu"], "kind": "cuda", "max_num_threads": 1024, "tag": "", "thread_warp_size": 32})})
        A = T.match_buffer(A_handle, (4096, 4096), "float16", strides=(4096, 1))
        B = T.match_buffer(B_handle, (4096, 4096), "float16", strides=(4096, 1))
        C = T.match_buffer(C_handle, (4096, 4096), strides=(4096, 1))
        # with T.sblock("root"):
        bx = T.launch_thread("blockIdx.x", 66)
        tx = T.launch_thread("threadIdx.x", 128)
        ty = T.launch_thread("threadIdx.y", 1)
        tz = T.launch_thread("threadIdx.z", 1)
        with T.sblock("tilelang_root"):
            T.reads()
            T.writes()
            T.sblock_attr({"tl.launch_threads": [128, 1, 1]})
            A_shared = T.sblock_alloc_buffer((128, 64), "float16", scope="shared.dyn")
            B_shared = T.sblock_alloc_buffer((128, 64), "float16", scope="shared.dyn")
            C_local = T.sblock_alloc_buffer((128, 128), scope="local.fragment")
            for w in range(16):
                if w * 66 + bx < 1024:
                    T.fill(T.region(C_local[0, 0], 2, 128, 128), 0)
                if w * 66 + bx < 1024:
                    for ko in range(64):
                        T.copy(T.region(A[T.Div(T.truncmod(w * 66 + bx, 256), 8) * 128, ko * 64], 1, 128, 64), T.region(A_shared[0, 0], 2, 128, 64))
                        T.copy(T.region(B[T.Div(w * 66 + bx, 256) * 1024 + T.truncmod(w * 66 + bx, 8) * 128, ko * 64], 1, 128, 64), T.region(B_shared[0, 0], 2, 128, 64))
                        T.gemm(T.region(A_shared[0, 0], 1, 128, 64), T.region(B_shared[0, 0], 1, 128, 64), T.region(C_local[0, 0], 3, 128, 128), T.bool(False), T.bool(True), 128, 128, 64, 0, T.bool(False), 0, 0, 0)
                if w * 66 + bx < 1024:
                    T.copy(T.region(C_local[0, 0], 1, 128, 128), T.region(C[T.Div(T.truncmod(w * 66 + bx, 256), 8) * 128, T.Div(w * 66 + bx, 256) * 1024 + T.truncmod(w * 66 + bx, 8) * 128], 2, 128, 128))