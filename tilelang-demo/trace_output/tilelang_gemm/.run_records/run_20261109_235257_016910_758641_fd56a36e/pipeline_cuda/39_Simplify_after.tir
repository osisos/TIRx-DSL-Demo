# from tvm.script import ir as I
# from tvm.script import tirx as T

@I.ir_module
class Module:
    @T.prim_func
    def main(A_handle: T.handle, B_handle: T.handle, C_handle: T.handle):
        T.func_attr({"target": T.target({"arch": "sm_89", "host": {"keys": ["cpu"], "kind": "c", "tag": ""}, "keys": ["cuda", "gpu"], "kind": "cuda", "max_num_threads": 1024, "tag": "", "thread_warp_size": 32}), "tl.has_tma": T.bool(False)})
        A = T.match_buffer(A_handle, (4096, 4096), "float16", strides=(4096, 1))
        B = T.match_buffer(B_handle, (4096, 4096), "float16", strides=(4096, 1))
        C = T.match_buffer(C_handle, (4096, 4096), strides=(4096, 1))
        bx = T.launch_thread("blockIdx.x", 66)
        thread_binding = T.launch_thread("threadIdx.x", 128)
        ty = T.launch_thread("threadIdx.y", 1)
        tz = T.launch_thread("threadIdx.z", 1)
        for w in range(16):
            C_local = T.alloc_buffer((128,), scope="local")
            C_local_1 = T.decl_buffer((128,), data=C_local.data, scope="local")
            if w * 66 + bx < 1024:
                for i in T.unroll(32):
                    for vec in T.vectorized(4):
                        C_local_1[i * 4 + vec] = T.float32(0.0)
            if w * 66 + bx < 1024:
                for ko in range(64):
