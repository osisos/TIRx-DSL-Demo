                    A_shared_1 = T.decl_buffer((1, 16, 512), "float16", data=A_shared.data, scope="shared.dyn")
                    B_shared = T.alloc_buffer((1, 16, 512), "float16", scope="shared.dyn")
                    B_shared_1 = T.decl_buffer((1, 16, 512), "float16", data=B_shared.data, scope="shared.dyn")
                    for i in T.unroll(8):
                        for vec in T.vectorized(8):
                            A_shared_1[0, i * 2 + thread_binding // 64, thread_binding % 64 // 8 * 64 + (thread_binding % 64 // 32 + thread_binding % 8 // 4) % 2 * 32 + (thread_binding % 32 // 16 + thread_binding % 4 // 2) % 2 * 16 + (thread_binding % 16 // 8 + thread_binding % 2) % 2 * 8 + vec] = A[T.Div(T.truncmod(w * 66 + bx, 256), 8) * 128 + i * 16 + thread_binding // 8, ko * 64 + thread_binding % 8 * 8 + vec]
                    for i in T.unroll(8):
                        for vec in T.vectorized(8):
                            B_shared_1[0, i * 2 + thread_binding // 64, thread_binding % 64 // 8 * 64 + (thread_binding % 64 // 32 + thread_binding % 8 // 4) % 2 * 32 + (thread_binding % 32 // 16 + thread_binding % 4 // 2) % 2 * 16 + (thread_binding % 16 // 8 + thread_binding % 2) % 2 * 8 + vec] = B[T.Div(w * 66 + bx, 256) * 1024 + T.truncmod(w * 66 + bx, 8) * 128 + i * 16 + thread_binding // 8, ko * 64 + thread_binding % 8 * 8 + vec]
                    T.attr(0, "lexical_alloc_scope", 1)
                    for ki in range(4):
                        A_local = T.alloc_buffer((32,), "float16", scope="local")
                        A_local_1 = T.decl_buffer((32,), "float16", data=A_local.data, scope="local")
                        B_local = T.alloc_buffer((32,), "float16", scope="local")
                        B_local_1 = T.decl_buffer((32,), "float16", data=B_local.data, scope="local")
                        for i in T.unroll(4):
                            T.ptx_ldmatrix(T.bool(False), 4, T.tvm_access_ptr(T.type_annotation("float16"), A_shared.data, thread_binding % 64 // 32 * 4096 + i * 1024 + thread_binding % 16 * 64 + ((ki * 16 + thread_binding % 32 // 16 * 8) // 32 + thread_binding % 8 // 4) % 2 * 32 + (thread_binding % 4 // 2 + ki % 2) % 2 * 16 + (thread_binding % 32 // 16 + thread_binding % 2) % 2 * 8, 8, 1), T.tvm_access_ptr(T.type_annotation("float16"), A_local.data, i * 8, 8, 2))
                        for i in T.unroll(4):
                            T.ptx_ldmatrix(T.bool(False), 4, T.tvm_access_ptr(T.type_annotation("float16"), B_shared.data, thread_binding // 64 * 4096 + i * 1024 + thread_binding % 32 // 16 * 512 + thread_binding % 8 * 64 + ((ki * 16 + thread_binding % 16 // 8 * 8) // 32 + thread_binding % 8 // 4) % 2 * 32 + (thread_binding % 4 // 2 + ki % 2) % 2 * 16 + (thread_binding % 16 // 8 + thread_binding % 2) % 2 * 8, 8, 1), T.tvm_access_ptr(T.type_annotation("float16"), B_local.data, i * 8, 8, 2))
                        for i, j in T.grid(4, 4):
                            T.ptx_mma("float32", "m16n8k16", "row", "col", "fp16", "fp16", "fp32", A_local.data, i * 8, B_local.data, j * 8, C_local.data, i * 32 + j * 8, T.bool(False))
                            T.ptx_mma("float32", "m16n8k16", "row", "col", "fp16", "fp16", "fp32", A_local.data, i * 8, B_local.data, j * 8 + 4, C_local.data, i * 32 + j * 8 + 4, T.bool(False))
            if w * 66 + bx < 1024:
                for i in T.unroll(64):
                    for vec in T.vectorized(2):
                        C[T.Div(T.truncmod(w * 66 + bx, 256), 8) * 128 + thread_binding % 64 // 32 * 64 + i // 16 * 16 + i % 2 * 8 + thread_binding % 32 // 4, T.Div(w * 66 + bx, 256) * 1024 + T.truncmod(w * 66 + bx, 8) * 128 + thread_binding // 64 * 64 + i % 16 // 2 * 8 + thread_binding % 4 * 2 + vec] = C_local_1[i * 2 + vec]