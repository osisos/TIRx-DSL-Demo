"""JIT decorators turn DSL factories into compiled-kernel factories."""
from typing import Any, Callable, Generic, ParamSpec, overload
from .kernel import JITKernel as JITKernel

_P = ParamSpec("_P")

class JITImpl(Generic[_P]):
    def __call__(self, *args: _P.args, **kwargs: _P.kwargs) -> JITKernel: ...
    def compile(self, *args: _P.args, **kwargs: _P.kwargs) -> JITKernel: ...

@overload
def jit(func: Callable[_P, Any], **kwargs: Any) -> JITImpl[_P]: ...
@overload
def jit(func: None = None, **kwargs: Any) -> Callable[[Callable[_P, Any]], JITImpl[_P]]: ...

def compile(*args: Any, **kwargs: Any) -> JITKernel: ...
def par_compile(*args: Any, **kwargs: Any) -> list[JITKernel]: ...
